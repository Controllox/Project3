<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Project3.MainWindow"
        Title="Waxmat" Width="450" Height="450" MinHeight="450" MinWidth="450">

    <Grid x:Name="gameBoard" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="White" Width="50" Height="50" Grid.Column="0" Grid.Row="0" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" Grid.Row="0" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="2" Grid.Row="0" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" Grid.Row="0" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="4" Grid.Row="0" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" Grid.Row="0" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="6" Grid.Row="0" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" Grid.Row="0" PointerPressed="SelectTile"/>

        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="1" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="1" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="1" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="1" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="1" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="1" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="1" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="1" PointerPressed="SelectTile"/>

        <Grid Background="White" Width="50" Height="50" Grid.Column="0" Grid.Row="2" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" Grid.Row="2" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="2" Grid.Row="2" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" Grid.Row="2" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="4" Grid.Row="2" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" Grid.Row="2" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="6" Grid.Row="2" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" Grid.Row="2" PointerPressed="SelectTile"/>

        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="3" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="3" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="3" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="3" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="3" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="3" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="3" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="3" PointerPressed="SelectTile"/>

        <Grid Background="White" Width="50" Height="50" Grid.Column="0" Grid.Row="4" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" Grid.Row="4" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="2" Grid.Row="4" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" Grid.Row="4" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="4" Grid.Row="4" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" Grid.Row="4" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="6" Grid.Row="4" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" Grid.Row="4" PointerPressed="SelectTile"/>

        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="5" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="5" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="5" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="5" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="5" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="5" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="5" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="5" PointerPressed="SelectTile"/>

        <Grid Background="White" Width="50" Height="50" Grid.Column="0" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="1" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="2" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="3" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="4" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="5" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="6" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="7" Grid.Row="6" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="0" Grid.Row="7" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="1" Grid.Row="7" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="2" Grid.Row="7" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="3" Grid.Row="7" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="4" Grid.Row="7" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="5" Grid.Row="7" PointerPressed="SelectTile"/>
        <Grid Background="#FF9A6400" Width="50" Height="50" Grid.Column="6" Grid.Row="7" PointerPressed="SelectTile"/>
        <Grid Background="White" Width="50" Height="50" Grid.Column="7" Grid.Row="7" PointerPressed="SelectTile"/>
    </Grid>
</Window>